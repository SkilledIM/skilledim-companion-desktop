{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SkilledIM Companion",
  "mainBinaryName": "SkilledIM.Companion",
  "version": "0.1.0",
  "identifier": "com.skilledim.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SkilledIM Companion",
        "width": 920,
        "height": 780,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.skilledim.com https://portal.skilledim.com http://localhost:* http://127.0.0.1:* ipc: tauri: https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["skilledim-companion"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "SkilledIM Companion desktop attendance agent",
    "longDescription": "SkilledIM Companion lets agents authorize through SkilledIM in the system browser and manage daily check-in / check-out from the desktop.",
    "copyright": "Copyright © SkilledIM",
    "publisher": "SkilledIM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
