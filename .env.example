# SkilledIM Companion environment
# Copy to `.env` for local overrides (never commit real secrets).

# SkilledIM API base URL (no trailing slash)
VITE_API_BASE_URL=https://api.skilledim.com

# SkilledIM portal (system-browser login). Companion opens PORTAL_BASE_URL/
# with companion query params (not /login — that 404s when already signed in).
# For local handoff testing while Companion Vite uses 5173:
#   cd ../portal && npx vite --port 5174
#   VITE_PORTAL_BASE_URL=http://localhost:5174
VITE_PORTAL_BASE_URL=https://portal.skilledim.com

# Set to true to exercise the UI without calling production APIs.
# Demo mode never calls production attendance endpoints.
VITE_DEMO_MODE=false
